# CallTwin — Render environment variables (NEVER commit real secrets)
NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=https://YOUR-CALLTWIN.onrender.com

# Database
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/calltwin?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
CALLTWIN_PRICE_ID=price_xxx
CALLTWIN_SETUP_PRICE_ID=price_xxx
LIFETIME_PRICE_ID=price_xxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# Used for multi-tenant inbound routing. Set each customer's CallTwin number here in their account.
# For the first/single-owner deployment, CALLTWIN_OWNER_EMAIL is the fallback.
CALLTWIN_OWNER_EMAIL=hsw365media@gmail.com

# AI voice + conversation
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sales/demo funnel
FUNNEL_LINK=https://hsw365.github.io/QUEENEE.github.io/signup.html
