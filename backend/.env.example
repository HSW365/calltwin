# Database / auth
MONGO_URI=
JWT_SECRET=
NODE_ENV=production

# Public backend URL
PUBLIC_BASE_URL=https://your-backend.onrender.com

# Stripe — create one-time Prices in Stripe Dashboard
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CALLTWIN_ONE_TIME_PRICE_ID=   # one-time $500 CallTwin price
WEBSITE_ONE_TIME_PRICE_ID=    # one-time website price; default display is $500
CALLTWIN_WEBSITE_BUNDLE_PRICE_ID= # optional bundle price; default display is $900
WEBSITE_DISPLAY_PRICE=500
BUNDLE_DISPLAY_PRICE=900

# Telnyx — no Twilio dependency
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=+1XXXXXXXXXX
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_VOICE=Telnyx.Natural.abbie
TELNYX_LANGUAGE=en-US
TELNYX_TRANSCRIPTION_PROVIDER=deepgram

# AI
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Sales funnel
